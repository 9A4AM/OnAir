{
  "name": "onair-rooms",
  "main": "src/index.js",
  "compatibility_date": "2026-05-03",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }],
  "observability": { "enabled": true }
  // Not deployed. Before deploying: `wrangler secret put ROOM_SECRET` (32+ random bytes, base64) and add a route / custom domain.
}
