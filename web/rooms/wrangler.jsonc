{
  "name": "onair-rooms",
  "main": "src/index.js",
  "compatibility_date": "2026-05-03",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "rooms.on-air.dev", "custom_domain": true }]
  // ROOM_SECRET (32+ random bytes, base64) is a Worker secret: `wrangler secret put ROOM_SECRET`.
}
