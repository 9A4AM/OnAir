{
  "name": "onair-discord",
  "main": "src/index.js",
  "compatibility_date": "2026-05-03",
  "vars": {
    "MAP_URL": "https://map.on-air.dev",
    "CF_ACCOUNT_ID": "a214ca5b8d6cdda4b4802acc6cc7f8be",   // an identifier, not a secret (the Browser Rendering call also needs the CF_API_TOKEN secret)
