    // Discord's signatures), so they live here; the bot token and the Cloudflare token are secrets and never go in this file.
    "DISCORD_APP_ID": "1558882824717602895",
    "DISCORD_PUBLIC_KEY": "3e2aeedc03232a3a2832f096ac2394c5555fc27ce2fa543778f14753b58087fd"
  },
  "observability": { "enabled": true }
}
