{
  "name": "onair-map",
  "main": "src/index.js",
  "compatibility_date": "2026-05-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "MAP", "class_name": "MapHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MapHub"] }],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "map.on-air.dev", "custom_domain": true }]
}
