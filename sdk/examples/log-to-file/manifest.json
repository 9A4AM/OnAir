{
  "id": "log-to-file",
  "name": "Log to file",
  "version": "1.0.0",
  "author": "OnAir contributors",
  "license": "CC0-1.0",
  "homepage": "https://github.com/adswill/OnAir",
  "description": "Appends automation events to events.log in the plugin's data folder. Set a prefix such as adsb. to log only those events.",
  "kind": "action",
  "abi_version": 1,
  "minimum_onair": "0.2.7",
  "library": {"macos": "log-to-file.dylib", "linux": "log-to-file.so", "windows": "log-to-file.dll"},
  "permissions": ["filesystem"],
  "settings": [
    {"key": "prefix", "label": "Only event types starting with", "type": "text", "default": ""}
  ]
}
